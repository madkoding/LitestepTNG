; ==============================================================================
;  config\menus\windows-settings.rc  -  shared by the themes; no look here (icons come from variables
;  each theme defines: none; empty = no icon).
;  Windows settings, as ms-settings: pages; classic panels only where no page exists. For *Popup menus only (no start menu uses it).
;  Owned by the repo: deploy and the installer overwrite it. Menus cannot be extended
;  from personal.rc (it is read before the theme; see AGENTS.md section 5).
; ==============================================================================
*Popup "$TxtSettings$" !Execute [ms-settings:]
*Popup "$TxtDisplay$" !Execute [ms-settings:display]
*Popup "$TxtBluetooth$" !Execute [ms-settings:bluetooth]
*Popup "$TxtWindowsUpdate$" !Execute [ms-settings:windowsupdate]
*Popup "$TxtControlPanel$" !Execute [control.exe]
*Popup "$TxtSystem$" !Execute [ms-settings:about]
*Popup "$TxtSound$" !Execute [ms-settings:sound]
*Popup "$TxtVolumeMixer$" !Execute [ms-settings:apps-volume]
*Popup "$TxtNetworkConnections$" !Execute [ms-settings:network-advancedsettings]
*Popup "$TxtNetwork$" !Execute [ms-settings:network]
*Popup "$TxtDevicesPrinters$" !Execute [ms-settings:printers]
*Popup "$TxtDesktopBackground$" !Execute [ms-settings:personalization-background]
*Popup "$TxtInstalledApps$" !Execute [ms-settings:appsfeatures]
*Popup "$TxtUserAccounts$" !Execute [ms-settings:yourinfo]
*Popup "$TxtDateTime$" !Execute [ms-settings:dateandtime]
*Popup "$TxtRegionLanguage$" !Execute [ms-settings:regionlanguage]
*Popup "$TxtPower$" !Execute [ms-settings:powersleep]
*Popup "$TxtMouse$" !Execute [ms-settings:mousetouchpad]
*Popup "$TxtFirewall$" !Execute [control.exe firewall.cpl]
*Popup "$TxtEnvironmentVariables$" !Execute [rundll32.exe sysdm.cpl,EditEnvironmentVariables]
