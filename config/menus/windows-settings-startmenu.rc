; ==============================================================================
;  config\menus\windows-settings-startmenu.rc  -  shared by the themes; no look here (icons come from variables
;  each theme defines: none; empty = no icon).
;  Windows settings, as ms-settings: pages; classic panels only where no page exists. Variant for *PopupStartMenu; menus\windows-settings.rc has the same entries for *Popup.
;  Owned by the repo: deploy and the installer overwrite it. Personal additions go in
;  personal.rc (star lines there add items).
; ==============================================================================
*PopupStartMenu "Configuración" !Execute [ms-settings:]
*PopupStartMenu "Pantalla" !Execute [ms-settings:display]
*PopupStartMenu "Bluetooth" !Execute [ms-settings:bluetooth]
*PopupStartMenu "Windows Update" !Execute [ms-settings:windowsupdate]
*PopupStartMenu "Panel de control" !Execute [control.exe]
*PopupStartMenu "Sistema" !Execute [ms-settings:about]
*PopupStartMenu "Sonido" !Execute [ms-settings:sound]
*PopupStartMenu "Mezclador de volumen" !Execute [ms-settings:apps-volume]
*PopupStartMenu "Conexiones de red" !Execute [ms-settings:network-advancedsettings]
*PopupStartMenu "Red e Internet" !Execute [ms-settings:network]
*PopupStartMenu "Dispositivos e impresoras" !Execute [ms-settings:printers]
*PopupStartMenu "Fondo de escritorio" !Execute [ms-settings:personalization-background]
*PopupStartMenu "Aplicaciones instaladas" !Execute [ms-settings:appsfeatures]
*PopupStartMenu "Cuentas de usuario" !Execute [ms-settings:yourinfo]
*PopupStartMenu "Fecha y hora" !Execute [ms-settings:dateandtime]
*PopupStartMenu "Región e idioma" !Execute [ms-settings:regionlanguage]
*PopupStartMenu "Energía" !Execute [ms-settings:powersleep]
*PopupStartMenu "Mouse" !Execute [ms-settings:mousetouchpad]
*PopupStartMenu "Firewall" !Execute [control.exe firewall.cpl]
*PopupStartMenu "Variables de entorno" !Execute [rundll32.exe sysdm.cpl,EditEnvironmentVariables]
