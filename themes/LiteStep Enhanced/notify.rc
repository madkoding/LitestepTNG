; ==============================================================================
;  NOTIFICACIONES (Notify.dll)
;  Las notificaciones de Windows aparecen como cajas apiladas de arriba hacia
;  abajo en el borde derecho del escritorio. Cada caja usa el marco del popup
;  (popupframe.png): app en la cabecera blanca, texto en el cuerpo, fecha y hora
;  abajo, y una X para descartarla.
;  Probar sin una notificacion real:  !NotifyTest "APP" "TITULO" "TEXTO"
;  Cerrar todas:                      !NotifyClear
; ==============================================================================
NotifyMarginTop 8
; A la izquierda de la primera columna de iconos del escritorio (MIcons, 128 px).
NotifyMarginRight 136
NotifyMarginBottom 8
NotifySpacing 6
NotifyTimeFormat "%d . %m . %Y   %H:%M"
; true: al cargar muestra tambien lo que ya hay en el centro de notificaciones.
NotifyShowExisting false
; true: la X tambien quita la notificacion del centro de notificaciones de Windows.
NotifyDismissFromSystem true
; Clic en una caja: lleva al programa que la envio (y true: ademas la cierra).
NotifyClickDismisses true
; Si la columna se llena: DropOldest quita del escritorio la mas antigua (sigue en el
; centro de notificaciones de Windows); Wait deja las nuevas ocultas hasta que haya sitio.
NotifyOverflow DropOldest
; Sonido al llegar una notificacion (con "No molestar" Windows no suena). Vacio = sin sonido.
NotifySound "$MMDir$sounds\notify.wav"

NotifyBoxWidth 240
NotifyBoxHeight 80
; En el escritorio, no por encima de las ventanas.
NotifyBoxAlwaysOnTop false
NotifyBoxTextAntiAliasMode $MMTextAA$
NotifyBoxBrushType Image
NotifyBoxImage "$MMImg$popupframe.png"
NotifyBoxImageScalingMode Edges
NotifyBoxImageEdgesLeft 64
NotifyBoxImageEdgesTop 18
NotifyBoxImageEdgesRight 20
NotifyBoxImageEdgesBottom 18
NotifyBoxColor #00000000
NotifyBoxFontColor #00000000
NotifyBoxShowAnimationDuration 200
NotifyBoxShowAnimationOffset -10

; Nombre de la aplicacion, en la cabecera blanca.
NotifyBoxTitleX 70
NotifyBoxTitleY 3
NotifyBoxTitleWidth 100%-92
NotifyBoxTitleHeight 12
NotifyBoxTitleColor #00000000
NotifyBoxTitleFont $MMFont$
NotifyBoxTitleFontSize $MMFontSize$
NotifyBoxTitleFontColor #FF000000
NotifyBoxTitleTextAlign Left
NotifyBoxTitleTextVerticalAlign Middle

; La X, al final de la cabecera. CloseArea es su zona de clic, invisible y mucho mayor que
; el dibujo (10x10): todo el extremo derecho de la cabecera cierra la notificacion sin
; abrir el programa. Un clic en el resto de la caja si lleva al programa.
NotifyBoxCloseAreaX 100%-34
NotifyBoxCloseAreaY 0
NotifyBoxCloseAreaWidth 34
NotifyBoxCloseAreaHeight 20
NotifyBoxCloseAreaColor #00000000
NotifyBoxCloseX 100%-17
NotifyBoxCloseY 4
NotifyBoxCloseWidth 10
NotifyBoxCloseHeight 10
NotifyBoxCloseColor #00000000
NotifyBoxCloseBrushType Image
NotifyBoxCloseImage "$MMImg$lsnotes-close.png"
NotifyBoxCloseImageScalingMode Stretch
NotifyBoxCloseHoverImage "$MMImg$lsnotes-close-clicked.png"
NotifyBoxCloseHoverImageScalingMode Stretch

; Titulo y texto de la notificacion.
NotifyBoxTextX 38
NotifyBoxTextY 21
NotifyBoxTextWidth 100%-46
NotifyBoxTextHeight 100%-39
NotifyBoxTextColor #00000000
NotifyBoxTextFont $MMFont$
NotifyBoxTextFontSize $MMFontSize$
NotifyBoxTextFontColor #FF000000
NotifyBoxTextTextAlign Left
NotifyBoxTextTextVerticalAlign Top
NotifyBoxTextWordWrapping Wrap

; Fecha y hora en que llego.
NotifyBoxTimeX 38
NotifyBoxTimeY 100%-17
NotifyBoxTimeWidth 100%-62
NotifyBoxTimeHeight 12
NotifyBoxTimeColor #00000000
NotifyBoxTimeFont $MMFont$
NotifyBoxTimeFontSize $MMFontSize$
NotifyBoxTimeFontColor #FF000000
NotifyBoxTimeTextAlign Left
NotifyBoxTimeTextVerticalAlign Middle
