;[  shortcut.settings  ]

*Shortcut "Winamp" -380 0 winamp.bmp .none .none $winamp$
*Shortcut "Vorheriger Titel" -335 0 prev.bmp .none .none !AMP_PREV
*Shortcut "Abspielen" -310 0 play.bmp .none .none !AMP_PLAY
*Shortcut "Pause" -285 0 pause.bmp .none .none !AMP_PAUSE
*Shortcut "Stop" -260 0 stop.bmp .none .none !AMP_STOP
*Shortcut "Nächster Titel" -236 0 next.bmp .none .none !AMP_NEXT
*Shortcut "Eject" -212 0 eject.bmp .none .none !AMP_LOADFILE
*Shortcut "Playlist" -184 0 playlist.bmp .none .none !AMP_PLAYLIST
;*Shortcut "Dir" -212 0 dir.bmp .none .none !AMP_LOADDIR
*Slider "Track" -229 24 1 "slidertrack.bmp" "Slider_Handle.bmp" HI [WINAMP] 0
*Slider "Volume" -115 24 1 "slidervolume.bmp" "Slider_Handle.bmp" HI [VOLUME] 0

