;================================================
;   .: metamorphosis General Settings
;================================================

OTSMajorVersion 2
OTSMinorVersion 0

ThemeName      "metamorphosis"
ThemeAuthor    "Norman Kaczmarek"

                  
LSImageFolder     "$ThemeDir$images\"
RainlendarPath    "$ThemeDir$modules\" 

ConfigDir	$ThemeDir$Config\            

include	$ConfigDir$themevars.rc

ColorRGB

;[  modules  ]


*NetLoadmodule jdesk-0.711
*NetLoadModule label-1.99
*NetLoadModule shortcut2-2.0
*NetLoadModule popup2-2.0
*NetLoadModule taskbar3-0.305
*NetLoadModule geekamp-1.9.7
;*NetLoadModule lsquickbox-1.51  ;uncomment and see if u get any errors. i get a lsapi.dll missing error !!!! -143lsstep
*NetLoadModule lsslider-1.71
*NetLoadModule vtray-1.06
*NetLoadModule lslnkmenu-1.75
*NetLoadModule textedit-2.4l-13
*NetLoadmodule ckvwm-1.40
*NetLoadModule lsxcommand-1.8.4

VtraySettingsCompatibility

LsLnkMenuControlFile $ConfigDir$lslnkmenu.ini

NoteDefWidth 150	;// Default width
NoteDefHeight 150	;// Default height
NoteDefX 100		;// Default X (where new notes show up)
NoteDefY 100		;// Default Y
NoteDefFontSize 10	;// Default font size
NoteDefFontFace "Sevenet 7"	;// Default font face
NoteDefFontColor FFFFFF
NoteDefBG lsnotes.bmp	;// This bmp can have FF00FF around the borders
NoteBorderTop 15
NoteBorderRight 5
NoteBorderBottom 5
NoteBorderLeft 5
NoteScrollTrackBmp lsnotes-track.bmp 			
NoteScrollUp 10						
NoteScrollDown 10					
NoteScrollBmp lsnotes-scroll.bmp			
NoteCloseButtonBmp lsnotes-close.bmp			
NoteCloseButtonClickedBmp lsnotes-close-clicked.bmp	
NoteCloseX -25						
NoteCloseY 2						

AmpTimeX 446
AmpTimeY 33
AmpTimeWidth 60
AmpTimeHeight 15
AmpTimeFont "Sevenet 7"
AmpTimeBGColor 000058
AmpTimeTextColor ffffff
AmpTimeTextSize 8

;[  desktop.settings  ]

;SetDesktopArea
;SDATop 28
;SDALeft 5
;DesktopRightClick            !popup

jdeskworkarea "5,28,0,-29"

;[  ls.mail  ]

;[  ls.label  ]

IF ResolutionX=800
	Labels TimeLabel,DateLabel,WinampLabel
ELSE
	Labels TimeLabel,DateLabel,WinampLabel,DeskLabel
ENDIF

DeskLabelText "[username]'s Desktop"
DeskLabelHeight 13
DeskLabelWidth 150
;DeskLabelX 438
DeskLabelX -74c
DeskLabelY 1
DeskLabelImage desklabel.bmp
DeskLabelTransparent
DeskLabelFont "hooge 05_53"
DeskLabelFontHeight 10
DeskLabelFontColor 000000
DeskLabelScroll
DeskLabelJustify center

WinampLabelText "[winampsong] - [winamptime] / [winamptotaltime] ****"
WinampLabelHeight 19
WinampLabelWidth 152
WinampLabelX -157
WinampLabelY 0
WinampLabelImage winamplabel.bmp
WinampLabelTransparent
WinampLabelFontShadow
WinampLabelFontShadowColor 000000
WinampLabelFont "hooge 05_53"
WinampLabelFontHeight 10
WinampLabelFontColor FFFFFF
WinampLabelScroll
WinampLabelJustify left

TimeLabelText "[time('ii:nn:ss')]h"
TimeLabelHeight 18
TimeLabelWidth 110
TimeLabelX 20
TimeLabelY 3
TimeLabelImage timeback.bmp
TimeLabelTransparent
TimeLabelFontShadow
TimeLabelFontShadowColor 000000
TimeLabelFont "hooge 05_53"
TimeLabelFontHeight 20
TimeLabelFontColor FFFFFF
TimeLabelOnmouseleave !Execute [!TimeLabelShow][!CommandHide]
TimeLabelOnmouseenter !Execute [!TimeLabelHide][!FocusCommand]

DateLabelText "[date('dd. mmmm yyyy')]"
DateLabelHeight 10
DateLabelWidth 120
DateLabelX 15
DateLabelY 22
DateLabelImage dateback.bmp
DateLabelFontShadow
DateLabelFontShadowColor 000000
DateLabelFont "hooge 05_53"
DateLabelFontHeight 10
DateLabelFontColor FFFFFF
DateLabelOnLeftClick !DateLabelSetText [uptime]

;[  quick.box  ]

QBoxHeight 20
QBoxWidth  111
QBoxPosX   177
QBoxPosY   0
;QBoxBGColor 000000
QBoxSkin "quicckbox.bmp"
QBoxNoBorder

;[  command  ]

CommandHiddenOnStart
CommandX 6            		;x position on the screen
CommandY 8			;y position on the screen
CommandWidth 140		;width in pixels
CommandHeight 14		;height in pixels
CommandBorderSize 1		;width in pixels of the border
CommandTextSize 12		;pixel size of the text
CommandBGColor 000000		;background color
CommandTextColor FFFFFF		;text color
CommandBorderColor FFFFFF	;color of the border
CommandTextFontFace "Sevenet 7"	;font for the text
CommandClearOnCommand
CommandClearOnHide		;clear the text when mod is hidden
CommandNoCursorChange
CommandNotMoveable		;if this is set you will not be able to drag it around by the border
CommandNotAlwaysOnTop		;overides the default of being Always On Top of other windows
;CommandScrollWinAmpTitle

;[  popup  ]

HotListName "menu"

PopupTitlePix      "popuptop2.bmp"
PopupEntryPix      "popupnorm.bmp"
PopupSeparatorPix      "popupnorm.bmp"
PopupSelEntryPix   "popupselect.bmp"
PopupBottomPix     "popupbottom.bmp"
PopupArrowImage    "popuparrow.bmp"
PopupSelArrowImage "popuparrowselect.bmp"

;PopupWidth 178

PopupTitleAlignment right

PopupTextOffset 10
PopupIconSpacing 12

PinnedPopupNotOnTop

PopupNoTitleText
PopupNoMenuBevel
PopupNoBevel
PopupFolderIcon
PopupFolderArrow
;PinnedPopupNotOnTop
;PopupTitleBold

PopupTitleColor "000000"
PopupEntryColor "000000"
PopupSelEntryColor "FFFFFF"
PopupSubMenuHeight "18"
PopupFontFace "hooge 05_53"
PopupFontHeight "10"
PopupTextOffset "10"
PopupMenuDelay "200"
PopupMinWidth 178
PopupMaxWidth 300

PopupDateTimeAlign 2

;[  systray  ]

SystrayAutoSize
SystrayBitmap systrayback.bmp
SystrayBitmapTiled
SystrayDirection left
SystrayIconSize 16

SystrayIconSpacingX 4

;SystrayMinWidth -1

;SystrayMinHeight -1
;SystrayMaxWidth -1
;SystrayMaxHeight -1
SystrayX -84
SystrayY -53
.SystraySnapDistance 4
SystraySpacingX 4
SystraySpacingY 4
.SystrayWrapCount -1

;[  tasks.settings  ]


TaskBarX 0
TaskBarY -28
TaskbarSkin    "Taskbar.bmp"
TaskbarNormalSkinCenter "Regtaskmain.bmp"
TaskbarNormalSkinleft "Regtaskleft.bmp"
TaskbarNormalSkinright "Regtaskleft.bmp"
TaskbarActiveSkinCenter "RegTaskmainselected.bmp"
TaskbarActiveSkinLeft "Regtaskleft.bmp"
TaskbarActiveSkinRight "Regtaskmainselectedright.bmp"
TaskbarMinimizedSkinCenter "Regtaskmain.bmp"
TaskbarMinimizedSkinleft "Regtaskleft.bmp"
TaskbarMinimizedSkinright "Regtaskleft.bmp"

TaskBarBorder 0 0 4 0

TaskbarNormalFontFace "hooge 05_53"
TaskbarNormalFontHeight 10
TaskbarNormalFontColor FFFFFF
TaskbarActiveFontColor FFFFFF
TaskbarMinimizedFontColor FFFFFF

TaskBarNoTextShift
TaskbarNoSkinShift
;TaskButtonFlash



	
;[  virtualdesktops.settings  ]

VWMNoAutoSwitch
VWMDesksX "4"
VWMDesksY "1"
VWMNoGathering
VWMFocusCenter
VWMVelocity "500"
VWMSecurityDistance "25"
VWMForeColor "A8C0D0"
VWMSelBackColor "FFFFFF"
VWMBorderColor "A8C0D0"
vwmBackColor "000000"
VWMNotAlwaysOnTop
VWMBackBmp vwm.bmp
VWMSelBmp  vwm_sel.bmp
VWMx 154
VWMy 24
VWMwidth 80
VWMheight 14

;[  Popup Entries  ]

PopupIcons
PopupIconHeight 16
PopupIconWidth 16
PopupIconSize 16

