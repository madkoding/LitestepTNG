; ==============================================================================
;  LSLNKMENU  -  categorias (OFFICE/GRAPHIC/MULTIMEDIA/INTERNET/TOOLS)
;  Tira centrada en la fila superior inferior; cada una abre un popup de apps.
; ==============================================================================
*nLabel MLnkOffice
MLnkOfficeX 1385
MLnkOfficeY 100%-50
MLnkOfficeWidth 134
MLnkOfficeHeight 21
MLnkOfficeAlwaysOnTop true
MLnkOfficeColor #01000000
MLnkOfficeBrushType Image
MLnkOfficeImage "$MMImg$office.png"
MLnkOfficeImageScalingMode Stretch
MLnkOfficeOn LeftClickUp None !PopupLnkOffice

*nLabel MLnkGraphic
MLnkGraphicX 1519
MLnkGraphicY 100%-50
MLnkGraphicWidth 134
MLnkGraphicHeight 21
MLnkGraphicAlwaysOnTop true
