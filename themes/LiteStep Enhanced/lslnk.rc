; ==============================================================================
;  LSLNKMENU  -  categorias (OFFICE/GRAPHIC/MULTIMEDIA/INTERNET/TOOLS)
;  Tira centrada en la fila superior inferior; cada una abre un popup de apps.
; ==============================================================================
*nLabel MLnkOffice
MLnkOfficeGroup MMPanelImage
MLnkOfficeX 50%-335
MLnkOfficeY 100%-50
MLnkOfficeWidth 134
MLnkOfficeHeight 21
MLnkOfficeAlwaysOnTop true
MLnkOfficeImage "$MMImg$office.png"
MLnkOfficeOn LeftClickUp None !PopupLnkOffice

*nLabel MLnkGraphic
MLnkGraphicGroup MMPanelImage
MLnkGraphicX 50%-201
MLnkGraphicY 100%-50
MLnkGraphicWidth 134
MLnkGraphicHeight 21
MLnkGraphicAlwaysOnTop true
MLnkGraphicImage "$MMImg$grafik.png"
MLnkGraphicOn LeftClickUp None !PopupLnkGraphic

*nLabel MLnkMulti
MLnkMultiGroup MMPanelImage
MLnkMultiX 50%-67
MLnkMultiY 100%-50
MLnkMultiWidth 134
MLnkMultiHeight 21
MLnkMultiAlwaysOnTop true
MLnkMultiImage "$MMImg$multimedia.png"
MLnkMultiOn LeftClickUp None !PopupLnkMulti

*nLabel MLnkInternet
MLnkInternetGroup MMPanelImage
MLnkInternetX 50%+67
MLnkInternetY 100%-50
MLnkInternetWidth 134
MLnkInternetHeight 21
MLnkInternetAlwaysOnTop true
MLnkInternetImage "$MMImg$internet.png"
MLnkInternetOn LeftClickUp None !PopupLnkInternet

*nLabel MLnkTools
MLnkToolsGroup MMPanelImage
MLnkToolsX 50%+201
MLnkToolsY 100%-50
MLnkToolsWidth 134
MLnkToolsHeight 21
MLnkToolsAlwaysOnTop true
MLnkToolsImage "$MMImg$tools.png"
MLnkToolsOn LeftClickUp None !PopupLnkTools
