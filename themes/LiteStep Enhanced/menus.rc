; ==============================================================================
;  LiteStep Enhanced - menus. The entries shared by every theme come from config\menus\
;  (text and command there; the icons are this theme's, set by the Icon* variables).
; ==============================================================================
IconExplorer "C:\Windows\explorer.exe,0"
IconTerminal "C:\Windows\System32\cmd.exe,0"
IconTaskManager "C:\Windows\System32\taskmgr.exe,0"
IconLock "C:\Windows\System32\shell32.dll,47"
IconLogoff "C:\Windows\System32\shell32.dll,44"
IconRestart "C:\Windows\System32\shell32.dll,238"
IconShutdown "C:\Windows\System32\shell32.dll,27"

; --- Menu de inicio (clic derecho en MENU, clic central en el escritorio) ---
*PopupStartMenu .icon="C:\Windows\System32\shell32.dll,19" "$TxtPrograms$" !PopupPrograms
*PopupStartMenu .icon="C:\Windows\System32\shell32.dll,21" "$TxtRecent$" !PopupRecentDocuments
*PopupStartMenu .icon="C:\Windows\System32\imageres.dll,104" "$TxtComputer$" !PopupMyComputer
*PopupStartMenu !Separator
include "$LiteStepDir$config\menus\apps-startmenu.rc"
*PopupStartMenu .icon="C:\Windows\System32\shell32.dll,25" "$TxtRun$" !Run
*PopupStartMenu !Separator
; El listado completo de Configuracion esta en el submenu del menu contextual; aqui basta
; la app (StartMenu no anida carpetas: un Folder se mostraria desplegado).
*PopupStartMenu "$TxtSettings$" !Execute [ms-settings:]
*PopupStartMenu "$TxtCapture$" Folder
include "$LiteStepDir$config\menus\capture-startmenu.rc"
*PopupStartMenu ~Folder
*PopupStartMenu !Separator
include "$LiteStepDir$config\menus\session-startmenu.rc"

; --- Menu contextual (clic en MENU, clic derecho en el escritorio, Win+X) ---
*Popup !New !PopupContext
include "$LiteStepDir$config\menus\apps.rc"
*Popup !Separator
; FAVORITOS: lista propia de litestep (carpeta favorites\ junto a litestep.exe).
; Clic derecho sobre un programa o documento -> anadir; sobre un favorito -> quitar.
*Popup .icon="C:\Windows\System32\shell32.dll,43" "$TxtFavorites$" !PopupPinned
; JUEGOS: los accesos directos (.lnk, .url) de la carpeta games\ junto a step.rc. Es
; contenido personal, no del tema: se anaden o quitan archivos ahi, sin tocar este fichero.
*Popup .icon="C:\Windows\System32\joy.cpl,0" "$TxtGames$" !PopupFolder:"$LiteStepDir$games"
*Popup .icon="C:\Windows\System32\shell32.dll,316" "$TxtWindowsSettings$" Folder
include "$LiteStepDir$config\menus\windows-settings.rc"
*Popup ~Folder
*Popup .icon="C:\Windows\System32\snippingtool.exe,0" "$TxtCapture$" Folder
include "$LiteStepDir$config\menus\capture.rc"
*Popup ~Folder
*Popup .icon="C:\Windows\System32\shell32.dll,138" "$TxtMultimedia$" Folder
include "$LiteStepDir$config\menus\media.rc"
*Popup ~Folder
*Popup .icon="C:\Windows\System32\shell32.dll,22" "$TxtShell$" Folder
*Popup "$TxtRecycleLiteStep$" !Recycle
*Popup "$TxtGatherWindows$" !VWMGather
*Popup "$TxtEditTheme$" !Execute [explorer.exe "$LiteStepDir$themes\$ThemeName$"]
*Popup "$TxtThemes$" !PopupThemes
*Popup ~Folder
*Popup !Separator
*Popup .icon="$IconShutdown$" "$TxtShutDown$" !Execute [shutdown.exe /s /t 0]
*Popup !Separator
*Popup !Info "$TxtDateLabel$  [Time('%d . %m . %Y')]"
*Popup !Info "$TxtTimeLabel$  [Time('%H : %M : %S')]"
*Popup ~New

*Popup !New !PopupTray
*Popup "$TxtNetworkConnections$" !Execute [ms-settings:network-advancedsettings]
*Popup "$TxtSound$" !Execute [ms-settings:sound]
*Popup "$TxtDevicesPrinters$" !Execute [ms-settings:printers]
*Popup "$TxtVolumeMixer$" !Execute [ms-settings:apps-volume]
*Popup !Separator
*Popup "$TxtTaskManager$" !Execute [taskmgr.exe]
*Popup ~New

; --- Popups del LSLNKMENU (categorias) ---
*Popup "$TxtOffice$" !New !PopupLnkOffice MMMenuLnk
*Popup "WORD" !Execute [winword.exe]
*Popup "EXCEL" !Execute [excel.exe]
*Popup "POWERPOINT" !Execute [powerpnt.exe]
*Popup "OUTLOOK" !Execute [outlook.exe]
*Popup "ONENOTE" !Execute [onenote.exe]
*Popup "WORDPAD" !Execute [write.exe]
*Popup ~New

*Popup "$TxtGraphics$" !New !PopupLnkGraphic MMMenuLnk
*Popup "PAINT" !Execute [mspaint.exe]
*Popup "$TxtPhotos$" !Execute [ms-photos:]
*Popup "$TxtSnips$" !Execute [snippingtool.exe]
*Popup "PAINT 3D" !Execute [ms-paint:]
*Popup ~New

*Popup "$TxtMultimedia$" !New !PopupLnkMulti MMMenuLnk
*Popup "SPOTIFY" !Execute [spotify:]
*Popup "$TxtPlayer$" !Execute [mswindowsmusic:]
*Popup "$TxtVoiceRecorder$" !Execute [ms-callrecording:]
*Popup "$TxtVolume$" !Execute [sndvol.exe]
*Popup ~New

*Popup "$TxtInternet$" !New !PopupLnkInternet MMMenuLnk
*Popup "EDGE" !Execute [msedge.exe]
*Popup "CHROME" !Execute [chrome.exe]
*Popup "FIREFOX" !Execute [firefox.exe]
*Popup "$TxtNetworkConnections$" !Execute [ms-settings:network-advancedsettings]
*Popup ~New

*Popup "$TxtTools$" !New !PopupLnkTools MMMenuLnk
*Popup "$TxtTerminal$" !Execute [wt.exe]
*Popup "$TxtTaskManager$" !Execute [taskmgr.exe]
*Popup "$TxtControlPanel$" !Execute [control.exe]
*Popup "$TxtExplorer$" !Execute [explorer.exe]
*Popup "$TxtEditTheme$" !Execute [explorer.exe "$LiteStepDir$themes\$ThemeName$"]
*Popup ~New
