; ==============================================================================
;  LiteStep Enhanced - menus. The entries shared by every theme come from config\menus\
;  (text and command there; the icons are this theme's, set by the Icon* variables).
; ==============================================================================
IconExplorer C:\Windows\explorer.exe,0
IconTerminal C:\Windows\System32\cmd.exe,0
IconTaskManager C:\Windows\System32\taskmgr.exe,0
IconLock C:\Windows\System32\shell32.dll,47
IconLogoff C:\Windows\System32\shell32.dll,44
IconRestart C:\Windows\System32\shell32.dll,238
IconShutdown C:\Windows\System32\shell32.dll,27

; --- Menu de inicio (clic derecho en MENU, clic central en el escritorio) ---
*PopupStartMenu .icon="C:\Windows\System32\shell32.dll,19" "PROGRAMAS" !PopupPrograms
*PopupStartMenu .icon="C:\Windows\System32\shell32.dll,21" "RECIENTES" !PopupRecentDocuments
*PopupStartMenu .icon="C:\Windows\System32\imageres.dll,104" "EQUIPO" !PopupMyComputer
*PopupStartMenu !Separator
include "$LiteStepDir$config\menus\apps-startmenu.rc"
*PopupStartMenu .icon="C:\Windows\System32\shell32.dll,25" "EJECUTAR..." !Run
*PopupStartMenu !Separator
; El listado completo de Configuracion esta en el submenu del menu contextual; aqui basta
; la app (StartMenu no anida carpetas: un Folder se mostraria desplegado).
*PopupStartMenu "Configuración" !Execute [ms-settings:]
*PopupStartMenu "CAPTURAS" Folder
include "$LiteStepDir$config\menus\capture-startmenu.rc"
*PopupStartMenu ~Folder
*PopupStartMenu !Separator
include "$LiteStepDir$config\menus\session-startmenu.rc"

; --- Menu contextual (clic en MENU, clic derecho en el escritorio, Win+X) ---
*Popup !New !PopupContext
include "$LiteStepDir$config\menus\apps.rc"
*Popup !Separator
; FAVORITOS: lista propia de litestep (carpeta favorites\ junto a litestep.exe).
; Clic derecho sobre un programa o documento -> anadir; sobre un favorito -> quitar.
nPopupPinText "Anadir a favoritos"
nPopupUnpinText "Quitar de favoritos"
*Popup .icon="C:\Windows\System32\shell32.dll,43" "FAVORITOS" !PopupPinned
; JUEGOS: los accesos directos (.lnk, .url) de la carpeta games\ junto a step.rc. Es
; contenido personal, no del tema: se anaden o quitan archivos ahi, sin tocar este fichero.
*Popup .icon="C:\Windows\System32\joy.cpl,0" "JUEGOS" !PopupFolder:"$LiteStepDir$games"
*Popup .icon="C:\Windows\System32\shell32.dll,316" "CONFIGURACION DE WINDOWS" Folder
include "$LiteStepDir$config\menus\windows-settings.rc"
*Popup ~Folder
*Popup .icon="C:\Windows\System32\snippingtool.exe,0" "CAPTURAS" Folder
include "$LiteStepDir$config\menus\capture.rc"
*Popup ~Folder
*Popup .icon="C:\Windows\System32\shell32.dll,138" "MULTIMEDIA" Folder
include "$LiteStepDir$config\menus\media.rc"
*Popup ~Folder
*Popup .icon="C:\Windows\System32\shell32.dll,22" "SHELL" Folder
*Popup "RECARGAR LITESTEP" !Recycle
*Popup "REUNIR VENTANAS (ESCRITORIOS)" !VWMGather
*Popup "EDITAR TEMA" !Execute [explorer.exe "$LiteStepDir$themes\$ThemeName$"]
*Popup "TEMAS" !PopupThemes
*Popup ~Folder
*Popup !Separator
*Popup .icon="$IconShutdown$" "APAGAR" !Execute [shutdown.exe /s /t 0]
*Popup !Separator
*Popup !Info "FECHA:  [Time('%d . %m . %Y')]"
*Popup !Info "HORA:  [Time('%H : %M : %S')]"
*Popup ~New

*Popup !New !PopupTray
*Popup "CONEXIONES DE RED" !Execute [ms-settings:network-advancedsettings]
*Popup "SONIDO" !Execute [ms-settings:sound]
*Popup "DISPOSITIVOS E IMPRESORAS" !Execute [ms-settings:printers]
*Popup "MEZCLADOR DE VOLUMEN" !Execute [ms-settings:apps-volume]
*Popup !Separator
*Popup "ADMINISTRADOR DE TAREAS" !Execute [taskmgr.exe]
*Popup ~New

; --- Popups del LSLNKMENU (categorias) ---
*Popup "OFFICE" !New !PopupLnkOffice MMMenuLnk
*Popup "WORD" !Execute [winword.exe]
*Popup "EXCEL" !Execute [excel.exe]
*Popup "POWERPOINT" !Execute [powerpnt.exe]
*Popup "OUTLOOK" !Execute [outlook.exe]
*Popup "ONENOTE" !Execute [onenote.exe]
*Popup "WORDPAD" !Execute [write.exe]
*Popup ~New

*Popup "GRAPHIC" !New !PopupLnkGraphic MMMenuLnk
*Popup "PAINT" !Execute [mspaint.exe]
*Popup "FOTOS" !Execute [ms-photos:]
*Popup "RECORTES" !Execute [snippingtool.exe]
*Popup "PAINT 3D" !Execute [ms-paint:]
*Popup ~New

*Popup "MULTIMEDIA" !New !PopupLnkMulti MMMenuLnk
*Popup "SPOTIFY" !Execute [spotify:]
*Popup "REPRODUCTOR" !Execute [mswindowsmusic:]
*Popup "GRABADORA DE VOZ" !Execute [ms-callrecording:]
*Popup "VOLUMEN" !Execute [sndvol.exe]
*Popup ~New

*Popup "INTERNET" !New !PopupLnkInternet MMMenuLnk
*Popup "EDGE" !Execute [msedge.exe]
*Popup "CHROME" !Execute [chrome.exe]
*Popup "FIREFOX" !Execute [firefox.exe]
*Popup "CONEXIONES DE RED" !Execute [ms-settings:network-advancedsettings]
*Popup ~New

*Popup "TOOLS" !New !PopupLnkTools MMMenuLnk
*Popup "TERMINAL" !Execute [wt.exe]
*Popup "ADMINISTRADOR DE TAREAS" !Execute [taskmgr.exe]
*Popup "PANEL DE CONTROL" !Execute [control.exe]
*Popup "EXPLORADOR" !Execute [explorer.exe]
*Popup "EDITAR TEMA" !Execute [explorer.exe "$LiteStepDir$themes\$ThemeName$"]
*Popup ~New
