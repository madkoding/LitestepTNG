; ==============================================================================
;  Minimized windows: a thumbnail of their content over their task button
;  (TaskBar.dll, MinimizedShelf*). Click one to bring its window back.
; ==============================================================================
MinimizedShelfEnabled true
MinimizedShelfThumbHeight 120
MinimizedShelfMaxThumbWidth 220
MinimizedShelfPadding 6
MinimizedShelfGap 8
MinimizedShelfColor #CC101820
MinimizedShelfCornerRadiusX 12
MinimizedShelfCornerRadiusY 12
MinimizedShelfShadowPreset win11
