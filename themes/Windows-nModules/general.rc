LiteStepVersion "0.25.0"

; convenience paths for popup shortcuts and helper commands
SetEnv USERDOCS "$USERPROFILE$\Documents"
SetEnv USERDL "$USERPROFILE$\Downloads"
SetEnv USERMUSIC "$USERPROFILE$\Music"
SetEnv USERPICTURES "$USERPROFILE$\Pictures"

; load core experience modules
LoadModule $LiteStepDir$Core.dll
LoadModule $LiteStepDir$Wallpaper.dll
LoadModule $LiteStepDir$Popup.dll
LoadModule $LiteStepDir$HotKey.dll
LoadModule $LiteStepDir$SysTray.dll
LoadModule $LiteStepDir$TaskBar.dll
LoadModule $LiteStepDir$TaskSwitcher.dll
LoadModule $LiteStepDir$Label.dll
LoadModule $LiteStepDir$Clock.dll
LoadModule $LiteStepDir$StartMenu.dll
LoadModule $LiteStepDir$VWM.dll
LoadModule $LiteStepDir$Calendar.dll
LoadModule $LiteStepDir$Panels.dll

; ------------------------------------------------------------------------------
; desktop: Explorer's. LiteStep runs on top of it, so the wallpaper and the desktop
; icons are Windows' own. The theme's picture goes up on load and the user's comes
; back when a theme without one is chosen (Wallpaper module).
; ------------------------------------------------------------------------------
ThemeWallpaper "$WINDIR$Web\Wallpaper\Windows\img0.jpg"
ThemeWallpaperStyle Fill

; Core hides Windows' taskbar and keeps room for the theme's bars: top 42, bottom 54.
ReserveScreenTop 42
ReserveScreenBottom 54

OnStartup !PanelsRefresh
OnRefresh !PanelsRefresh

; virtual desktops (nVWM); the indicator in the top bar follows the current one
VWMDesktops 3
VWMDesk1Command !nLabelSetText DesktopIndicator "$TxtDesktop$ 1"
VWMDesk2Command !nLabelSetText DesktopIndicator "$TxtDesktop$ 2"
VWMDesk3Command !nLabelSetText DesktopIndicator "$TxtDesktop$ 3"

; ------------------------------------------------------------------------------
; keyboard shortcuts (Win+Tab and Alt+Tab stay Windows')
; ------------------------------------------------------------------------------
*HotKey WIN SPACE !Popup
*HotKey WIN V !PopupDesktops
*HotKey WINCTRL LEFT !VWMPrev
*HotKey WINCTRL RIGHT !VWMNext
*HotKey ALT OEM_3 !TaskSwitch
; desktop clicks (right: context menu, middle: start menu) and the shared hotkeys
include "$LiteStepDir$config\hotkeys.rc"
