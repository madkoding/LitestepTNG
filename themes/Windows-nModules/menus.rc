; ------------------------------------------------------------------------------
; start menu entries and styling
; ------------------------------------------------------------------------------
PopupStartMenuWidth 280
PopupStartMenuMaxWidth 340
PopupStartMenuPadding 18 14 18 18
PopupStartMenuItemSpacing 6
PopupStartMenuAlwaysOnTop true
PopupStartMenuBlurBehind true
PopupStartMenuConfineToMonitor true
PopupStartMenuShadowPreset Win11
PopupStartMenuItemFont "Segoe UI"
PopupStartMenuItemFontSize 14
PopupStartMenuItemFontColor #FFE8F0FA
PopupStartMenuItemTextOffsetLeft 20
PopupStartMenuItemTextVerticalAlign Middle
PopupStartMenuItemColor #22101820
PopupStartMenuItemCornerRadius 14
PopupStartMenuItemHoverColor #55327FFE
PopupStartMenuItemHoverFontColor #FFFFFFFF
PopupStartMenuItemHoverCornerRadius 14
PopupStartMenuItemHoverTextOffsetLeft 20
PopupStartMenuItemHoverTextVerticalAlign Middle

*PopupStartMenu "$TxtPrograms$" !PopupPrograms
*PopupStartMenu "$TxtRecent$" !PopupRecentDocuments
*PopupStartMenu "$TxtSettings$" !Execute [ms-settings:]
*PopupStartMenu "$TxtNetworkPlaces$" !PopupNetwork
*PopupStartMenu "$TxtCommandPrompt$" !Execute [$WINDIR$\System32\cmd.exe]
*PopupStartMenu "$TxtRun$" !PopupRun
*PopupStartMenu "$TxtShutDown$" !PopupPower
*PopupStartMenu "$TxtRecycleBin$" !PopupRecycleBin

; desktop and context popups
; ------------------------------------------------------------------------------
HotlistName "Glassboard"
PopupIcons
PopupAdaptiveWidth
PopupMinWidth 200
PopupMaxWidth 360
PopupNoBevel

*PopupContext "$TxtExplorer$" !Execute [$WINDIR$\explorer.exe]
*PopupContext "$TxtTerminal$" !Execute [wt.exe]
*PopupContext "$TxtSettings$" !Execute [ms-settings:]
*PopupContext !Separator
*PopupContext "$TxtTaskManager$" !Execute [$WINDIR$\System32\Taskmgr.exe]
*PopupContext "$TxtRun$" !PopupRun
*PopupContext !Separator
*PopupContext "$TxtRecycleLiteStep$" !Recycle

*PopupTray "$TxtNotifications$" !Execute [ms-actioncenter:]
*PopupTray "$TxtNetwork$" !Execute [ms-settings:network]
*PopupTray "$TxtTaskManager$" !Execute [$WINDIR$\System32\Taskmgr.exe]

*PopupDesktops "$TxtDesktop$ 1" !VWMDesk 1
*PopupDesktops "$TxtDesktop$ 2" !VWMDesk 2
*PopupDesktops "$TxtDesktop$ 3" !VWMDesk 3
*PopupDesktops !Separator
*PopupDesktops "$TxtGatherWindows$" !VWMGather

; retain a lightweight master popup
*Popup "$TxtStart$" !Popup
*Popup "$TxtDesktops$" !PopupDesktops
*Popup "$TxtContext$" !PopupContext
*Popup !Separator
*Popup "$TxtRecycleLiteStep$" !Recycle
