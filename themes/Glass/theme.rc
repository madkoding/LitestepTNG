; ==============================================================================
;  LiteStep NG - theme oscuro estilo Windows 11
;  Solo usa claves/bangs que existen en los modulos de este build.
;  Backup del theme anterior: step.rc.bak-20261121
; ==============================================================================
;
;  This file only lists the theme's files, in order. The order matters:
;  - plain settings: the FIRST definition wins (personal.rc, included by step.rc before
;    the theme, overrides all of them; a theme value must come before a shared default
;    from config\ to override it);
;  - star lines (*Popup, *HotKey, ...): file order is item order.
;  Check a change with tools\rc_effective.py (see AGENTS.md).
; ==============================================================================

include "$LiteStepDir$themes\$ThemeName$\general.rc"
include "$LiteStepDir$themes\$ThemeName$\styles.rc"
include "$LiteStepDir$themes\$ThemeName$\bar-bottom.rc"
include "$LiteStepDir$themes\$ThemeName$\bar-top.rc"
include "$LiteStepDir$themes\$ThemeName$\popups.rc"
include "$LiteStepDir$themes\$ThemeName$\menus.rc"
include "$LiteStepDir$themes\$ThemeName$\notify.rc"
include "$LiteStepDir$themes\$ThemeName$\shadows.rc"
