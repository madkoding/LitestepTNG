; ==============================================================================
;  BARRA SUPERIOR   [<< > >>] ....... fecha/hora ....... [buscar][vistas][< >][campana]
; ==============================================================================
*nLabel TopBar
TopBarGroup GlassUiText
TopBarX 116
TopBarY 0
TopBarWidth 100%-240
TopBarHeight 32
TopBarFontSize 12
TopBarFontColor $TextDim$
TopBarTextVerticalAlign Middle
TopBarText "[Time('%A %d %B   %H:%M')]"
TopBarOn RightClickUp None !PopupContext

*nLabel MediaPrev
MediaPrevGroup GlassIconButton
MediaPrevX 0
MediaPrevY 0
MediaPrevWidth 44
MediaPrevHeight 32
MediaPrevFontSize 12
MediaPrevText ""
MediaPrevOn LeftClickUp None !MediaPrev

*nLabel MediaPlay
MediaPlayGroup GlassBarItem
MediaPlayX 44
MediaPlayY 0
MediaPlayWidth 36
MediaPlayHeight 32
MediaPlayFont $IconFont$
MediaPlayFontSize 12
MediaPlayFontColor $TextColor$
MediaPlayTextVerticalAlign Middle
MediaPlayText ""
MediaPlayOn LeftClickUp None !MediaPlayPause

*nLabel MediaNext
MediaNextGroup GlassIconButton
MediaNextX 80
MediaNextY 0
MediaNextWidth 36
MediaNextHeight 32
MediaNextFontSize 12
MediaNextText ""
MediaNextOn LeftClickUp None !MediaNext

; Botones derechos (no dependen de explorer.exe)
*nLabel TopRun
TopRunGroup GlassIconButton
TopRunX 100%-124
TopRunY 0
TopRunWidth 36
TopRunHeight 32
TopRunFontSize 13
TopRunText ""
TopRunOn LeftClickUp None !Run

*nLabel TopSettings
TopSettingsGroup GlassIconButton
TopSettingsX 100%-88
TopSettingsY 0
TopSettingsWidth 40
TopSettingsHeight 32
TopSettingsFontSize 13
TopSettingsText ""
TopSettingsOn LeftClickUp None !Execute [ms-settings:]

*nLabel TopPower
TopPowerGroup GlassIconButton
TopPowerX 100%-48
TopPowerY 0
TopPowerWidth 48
TopPowerHeight 32
TopPowerFontSize 13
TopPowerText ""
TopPowerOn LeftClickUp None !PopupPower
