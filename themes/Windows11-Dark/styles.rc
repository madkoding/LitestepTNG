; ==============================================================================
;  Windows11-Dark - styles. A label takes every key of its style it does not set
;  itself (<Label>Group <Style>, see Settings.cpp); styles build on each other.
; ==============================================================================

; A piece of the bars: bar colour, always on top, centred text.
W11BarItemColor $BarColor$
W11BarItemAlwaysOnTop true
W11BarItemTextAlign Center

; A dim icon button (Segoe Fluent Icons glyph) on a bar.
W11IconButtonGroup W11BarItem
W11IconButtonFont $IconFont$
W11IconButtonFontColor $TextDim$
W11IconButtonTextVerticalAlign Middle

; Text in the UI font on a bar.
W11UiTextGroup W11BarItem
W11UiTextFont $UIFont$
