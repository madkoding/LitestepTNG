; ==============================================================================
;  metamorphosis (LiteStep Enhanced) - PORT FIEL con skin de imagenes
;  Original: Norman Kaczmarek, 2001. Layout segun preview original.
;  Paneles metalicos FLOTAN sobre el escritorio (sin barra solida).
;  Fuente: hooge 05_55.  Texto en MAYUSCULAS via TextUppercase (source).
; ==============================================================================
LiteStepVersion "0.25.0"

; Opcion GLOBAL: muestra TODO el texto en mayusculas (reloj, tareas, menus,
; username...). Implementada en el source (ModuleKit). Pon false para desactivar.
TextUppercase true

MMDir  "$LiteStepDir$themes\Metamorphosis\"
MMImg  "$LiteStepDir$themes\Metamorphosis\images\"
MMFont "hooge 05_55"
MMFontSmall "hooge 05_55"
MMInk  #FFFFFFFF
MMDim  #FFC0C8CC
MMUser #FF500058
MMBase #FF000000

; LiteStep corre SOBRE explorer (litestep.exe -overlay): explorer sigue siendo el shell
; de Windows y nCore mantiene oculta su barra de tareas.
HideExplorerTaskbar true
; Espacio de pantalla para las barras del tema (px en el monitor principal).
; Lo reserva explorer mediante AppBars; ya no se usa *nDeskWorkArea.
ReserveScreenTop 48
ReserveScreenBottom 54

; El escritorio es de explorer: nHotKey intercepta estos clics sobre el y lanza el bang.
; Con MAYUS pulsada el clic llega a explorer (su menu contextual normal).
DesktopRightClick !PopupContext
DesktopMiddleClick !PopupStartMenu

LoadModule $LiteStepDir$Core.dll
LoadModule $LiteStepDir$VWM.dll
LoadModule $LiteStepDir$Wallpaper.dll
; nDesk no se carga sobre explorer: su escritorio queda debajo del de Windows y
; al cargar reescribe el area de trabajo que ahora gestiona explorer.
;LoadModule $LiteStepDir$Desk.dll
LoadModule $LiteStepDir$Popup.dll
LoadModule $LiteStepDir$HotKey.dll
LoadModule $LiteStepDir$SysTray.dll
LoadModule $LiteStepDir$TaskBar.dll
LoadModule $LiteStepDir$TaskSwitcher.dll
LoadModule $LiteStepDir$Label.dll
LoadModule $LiteStepDir$StartMenu.dll
LoadModule $LiteStepDir$Notify.dll

; ------------------------------------------------------------------------------
;  Escritorio: barra superior 48 px, barra inferior 32 px reservadas
; ------------------------------------------------------------------------------
nDeskDontRenderWallpaper false
;*nDeskWorkArea primary 0 48 0 54
;OnRefresh !nDeskSetWorkArea primary 0 48 0 54
*nDeskOn RightClickUp None !PopupContext
*nDeskOn MiddleClickUp None !PopupStartMenu

*HotKey CTRLALT F12 !PopupStartMenu
*HotKey WIN X       !PopupContext
*HotKey CTRLALT R   !Recycle
; Capturas: Win+Shift+S recorte, Win+Alt+R herramienta Recortes (foto/video)
*HotKey WINSHIFT S  !Execute [ms-screenclip:]
*HotKey WINALT R    !Execute [snippingtool.exe]

; ==============================================================================
;  BARRA SUPERIOR  =  fondo semi-transparente + panel izq + username + panel der
;  Los hijos overlay van CONTIGUOS tras cada panel.
; ==============================================================================

; --- Fondo superior semi-transparente (deja ver el wallpaper por debajo) ---
*nLabel MBarBG
MBarBGX 0
MBarBGY 0
MBarBGWidth 100%
MBarBGHeight 48
MBarBGAlwaysOnTop true
MBarBGColor #01000000
MBarBGOn RightClickUp None !PopupContext

; --- Panel IZQUIERDO: injektion.png (reloj + 1234 + MENU) ---
*nLabel MBarLeft
MBarLeftX 0
MBarLeftY 0
MBarLeftWidth 630
MBarLeftHeight 48
MBarLeftAlwaysOnTop true
MBarLeftTextAntiAliasMode Aliased
MBarLeftColor #01000000
MBarLeftBrushType Image
MBarLeftImage "$MMImg$injektion.png"
MBarLeftImageScalingMode Stretch
MBarLeftOn RightClickUp None !PopupContext
; Reloj y fecha centrados en la caja oscura (x 5..159 de injektion.png).
; La sombra dura del original (negra, +1,+1) se hace con una etiqueta gemela
; negra desplazada 1px; el motor solo ofrece contorno (FontStroke), no sombra.
*MBarLeftOverlayLabel MClockTimeSh MClockDateSh MClockTime MClockDate MMenuHit MDeskSel MDesk1 MDesk2 MDesk3 MDesk4 MMeterCPU MMeterGPU MMeterRAM MMeterVRAM

MClockTimeShX 6
MClockTimeShY 5
MClockTimeShWidth 150
MClockTimeShHeight 16
MClockTimeShColor #00000000
MClockTimeShFont $MMFont$
MClockTimeShFontSize 16
MClockTimeShFontColor #FF000000
MClockTimeShTextAlign Center
MClockTimeShTextVerticalAlign Middle
MClockTimeShText "[Time('%H:%M:%S')]H"

MClockDateShX 6
MClockDateShY 23
MClockDateShWidth 150
MClockDateShHeight 11
MClockDateShColor #00000000
MClockDateShFont $MMFontSmall$
MClockDateShFontSize 8
MClockDateShFontColor #FF000000
MClockDateShTextAlign Center
MClockDateShTextVerticalAlign Middle
MClockDateShText "[Time('%d. %B %Y')]"

MClockTimeX 5
MClockTimeY 4
MClockTimeWidth 150
MClockTimeHeight 16
MClockTimeColor #01000000
MClockTimeFont $MMFont$
MClockTimeFontSize 16
MClockTimeFontColor $MMInk$
MClockTimeTextAlign Center
MClockTimeTextVerticalAlign Middle
MClockTimeText "[Time('%H:%M:%S')]H"
MClockTimeOn LeftClickUp None !Execute [control.exe timedate.cpl]

MClockDateX 5
MClockDateY 22
MClockDateWidth 150
MClockDateHeight 11
MClockDateColor #01000000
MClockDateFont $MMFontSmall$
MClockDateFontSize 8
MClockDateFontColor $MMInk$
MClockDateTextAlign Center
MClockDateTextVerticalAlign Middle
MClockDateText "[Time('%d. %B %Y')]"

; Boton MENU dibujado en injektion.png: x 293..371 (294..357 en la base), y 0..19
MMenuHitX 294
MMenuHitY 1
MMenuHitWidth 64
MMenuHitHeight 18
MMenuHitColor #01000000
MMenuHitOn LeftClickUp None !PopupContext
MMenuHitOn RightClickUp None !PopupStartMenu

; Escritorios virtuales (modulo nVWM): los botones 1-4 dibujados en injektion.png
; ocupan x 157/177/197/217 (15 px) e y 24..36. MDeskSel es la marca del escritorio
; actual; nVWM la mueve con VWMDesk<N>Command.
VWMDesktops 4
VWMDesk1Command !nLabelMove MDeskSel 158 25
VWMDesk2Command !nLabelMove MDeskSel 178 25
VWMDesk3Command !nLabelMove MDeskSel 198 25
VWMDesk4Command !nLabelMove MDeskSel 218 25

MDeskSelX 158
MDeskSelY 25
MDeskSelWidth 13
MDeskSelHeight 11
MDeskSelColor #6034414A
MDeskSelClickThrough true

MDesk1X 157
MDesk1Y 24
MDesk1Width 15
MDesk1Height 13
MDesk1Color #01000000
MDesk1On LeftClickUp None !VWMDesk 1

MDesk2X 177
MDesk2Y 24
MDesk2Width 15
MDesk2Height 13
MDesk2Color #01000000
MDesk2On LeftClickUp None !VWMDesk 2

MDesk3X 197
MDesk3Y 24
MDesk3Width 15
MDesk3Height 13
MDesk3Color #01000000
MDesk3On LeftClickUp None !VWMDesk 3

MDesk4X 217
MDesk4Y 24
MDesk4Width 15
MDesk4Height 13
MDesk4Color #01000000
MDesk4On LeftClickUp None !VWMDesk 4

; Medidores del sistema en la caja oscura que el original reservaba al "quick launch"
; (x 180..287, y 1..18 de injektion.png): dos filas de dos. [GPU] y [VRAM] miden la
; tarjeta grafica con mas memoria dedicada. Clic: Administrador de tareas.
MMeterCPUX 182
MMeterCPUY 0
MMeterCPUWidth 52
MMeterCPUHeight 10
MMeterCPUColor #01000000
MMeterCPUFont $MMFontSmall$
MMeterCPUFontSize 8
MMeterCPUFontColor $MMInk$
MMeterCPUTextAlign Left
MMeterCPUTextVerticalAlign Middle
MMeterCPUText "CPU [CPU]%"
MMeterCPUOn LeftClickUp None !Execute [taskmgr.exe]

MMeterGPUX 231
MMeterGPUY 0
MMeterGPUWidth 57
MMeterGPUHeight 10
MMeterGPUColor #01000000
MMeterGPUFont $MMFontSmall$
MMeterGPUFontSize 8
MMeterGPUFontColor $MMInk$
MMeterGPUTextAlign Left
MMeterGPUTextVerticalAlign Middle
MMeterGPUText "GPU [GPU]%"
MMeterGPUOn LeftClickUp None !Execute [taskmgr.exe]

MMeterRAMX 182
MMeterRAMY 9
MMeterRAMWidth 52
MMeterRAMHeight 10
MMeterRAMColor #01000000
MMeterRAMFont $MMFontSmall$
MMeterRAMFontSize 8
MMeterRAMFontColor $MMInk$
MMeterRAMTextAlign Left
MMeterRAMTextVerticalAlign Middle
MMeterRAMText "RAM [Memory]%"
MMeterRAMOn LeftClickUp None !Execute [taskmgr.exe]

MMeterVRAMX 231
MMeterVRAMY 9
MMeterVRAMWidth 57
MMeterVRAMHeight 10
MMeterVRAMColor #01000000
MMeterVRAMFont $MMFontSmall$
MMeterVRAMFontSize 8
MMeterVRAMFontColor $MMInk$
MMeterVRAMTextAlign Left
MMeterVRAMTextVerticalAlign Middle
MMeterVRAMText "VRAM [VRAM]%"
MMeterVRAMOn LeftClickUp None !Execute [taskmgr.exe]

; --- Panel DERECHO: injektion2.png pegado al borde derecho ---
*nLabel MBarRight
MBarRightX 100%-394
MBarRightY 1
MBarRightWidth 394
MBarRightHeight 47
MBarRightAlwaysOnTop true
MBarRightTextAntiAliasMode Aliased
MBarRightColor #01000000
MBarRightBrushType Image
MBarRightImage "$MMImg$injektion2.png"
MBarRightImageScalingMode Stretch
*MBarRightOverlayLabel MHitWinamp MHitPrev MHitPlay MHitPause MHitStop MHitNext MNowPlaying MTrack MVolume

; Now playing (Spotify/Tidal/cualquier app) DENTRO de la caja oscura del panel
; (x 238..387, y 0..16 de injektion2.png); el texto largo se recorta en la caja.
MNowPlayingX 241
MNowPlayingY 1
MNowPlayingWidth 144
MNowPlayingHeight 15
MNowPlayingColor #01000000
MNowPlayingFont $MMFont$
MNowPlayingFontSize 8
MNowPlayingFontColor $MMInk$
MNowPlayingTextAlign Left
MNowPlayingTextVerticalAlign Middle
MNowPlayingText "[NowPlaying]"
MNowPlayingOn LeftClickUp None !Execute ["C:\Users\jlgon\AppData\Local\TIDAL\TIDAL.exe"]

; Zonas de clic = rectangulos de los botones dibujados en injektion2.png
; (prev 59, play 84, pause 109, stop 134, next 158; 20 px de ancho, y 0..17).
; Usan los bangs !Media* de nCore, que hablan con la sesion multimedia de Windows:
; las teclas multimedia simuladas no llegan a las apps sin explorer.exe.
MHitWinampX 32
MHitWinampY 0
MHitWinampWidth 22
MHitWinampHeight 18
MHitWinampColor #01000000
MHitWinampOn LeftClickUp None !Execute ["C:\Users\jlgon\AppData\Local\TIDAL\TIDAL.exe"]

MHitPrevX 59
MHitPrevY 0
MHitPrevWidth 20
MHitPrevHeight 18
MHitPrevColor #01000000
MHitPrevOn LeftClickUp None !MediaPrev

MHitPlayX 84
MHitPlayY 0
MHitPlayWidth 20
MHitPlayHeight 18
MHitPlayColor #01000000
MHitPlayOn LeftClickUp None !MediaPlay

MHitPauseX 109
MHitPauseY 0
MHitPauseWidth 20
MHitPauseHeight 18
MHitPauseColor #01000000
MHitPauseOn LeftClickUp None !MediaPause

MHitStopX 134
MHitStopY 0
MHitStopWidth 20
MHitStopHeight 18
MHitStopColor #01000000
MHitStopOn LeftClickUp None !MediaStop

MHitNextX 158
MHitNextY 0
MHitNextWidth 20
MHitNextHeight 18
MHitNextColor #01000000
MHitNextOn LeftClickUp None !MediaNext

; Sliders TRACK y VOLUME (nLabel con "Slider"): la etiqueta cubre el interior de la
; caja dibujada (track x 166..273, volume x 280..387, y 23..34) y el tirador
; slider_handle.png se mueve por ella. Clic o arrastre para ajustar; rueda en VOLUME.
MTrackX 166
MTrackY 23
MTrackWidth 108
MTrackHeight 12
MTrackColor #01000000
MTrackSlider Track
MTrackSliderHandle MTrackKnob
*MTrackOverlayLabel MTrackKnob

MTrackKnobX 0
MTrackKnobY 0
MTrackKnobWidth 6
MTrackKnobHeight 11
MTrackKnobBrushType Image
MTrackKnobImage "$MMImg$slider_handle.png"
MTrackKnobImageScalingMode Stretch
MTrackKnobClickThrough true

MVolumeX 280
MVolumeY 23
MVolumeWidth 108
MVolumeHeight 12
MVolumeColor #01000000
MVolumeSlider Volume
MVolumeSliderHandle MVolumeKnob
MVolumeOn WheelUp None !MediaVolume +5
MVolumeOn WheelDown None !MediaVolume -5
*MVolumeOverlayLabel MVolumeKnob

MVolumeKnobX 0
MVolumeKnobY 0
MVolumeKnobWidth 6
MVolumeKnobHeight 11
MVolumeKnobBrushType Image
MVolumeKnobImage "$MMImg$slider_handle.png"
MVolumeKnobImageScalingMode Stretch
MVolumeKnobClickThrough true

; --- Linea negra de 1px sobre el panel derecho: injektion2.png mide 47px y va
;     en Y=1; en el original la fila 0 es negra, no se ve el fondo ---
*nLabel MBarRightTop
MBarRightTopX 100%-394
MBarRightTopY 0
MBarRightTopWidth 394
MBarRightTopHeight 1
MBarRightTopAlwaysOnTop true
MBarRightTopColor #FF000000

; --- Nombre de usuario centrado sobre la franja clara (injektion3.png) ---
*nLabel MUser
MUserX 630
MUserY 0
MUserWidth 100%-1024
MUserHeight 15
MUserAlwaysOnTop true
MUserTextAntiAliasMode Aliased
MUserColor #01000000
MUserBrushType Image
MUserImage "$MMImg$injektion3.png"
MUserImageScalingMode Stretch
MUserFont $MMFont$
MUserFontSize 8
MUserFontColor $MMUser$
MUserTextAlign Center
MUserTextVerticalAlign Middle
MUserText "MADKODING DESKTOP"
MUserOn RightClickUp None !PopupContext

; ==============================================================================
;  BARRA INFERIOR  -  TAREAS (abajo, full width) + BANDEJA (abajo derecha)
; ==============================================================================
*nTaskbar MTasks
; Sin MTasksMonitor la barra lista las ventanas de TODOS los monitores.
; Para limitarla a uno: MTasksMonitor primary
MTasksX 0
MTasksY 100%-26
MTasksWidth 100%
MTasksHeight 26
MTasksAlwaysOnTop true
MTasksTextAntiAliasMode Aliased
MTasksColor $MMBase$
MTasksBrushType Image
MTasksImage "$MMImg$taskbar.png"
MTasksImageScalingMode Stretch
MTasksPaddingLeft 2
MTasksPaddingTop 2
MTasksPaddingRight 2
MTasksPaddingBottom 2
MTasksPrimaryDirection Horizontal
MTasksStart TopLeft
MTasksColumnSpacing 2
; Al abrir o cerrar una ventana los botones se deslizan a su sitio (ms; 0 = sin animacion)
MTasksAnimationDuration 180
MTasksButtonWidth 200
MTasksButtonMaxWidth 200
MTasksButtonHeight 24
MTasksButtonMaxHeight 24
MTasksButtonColor #00000000
MTasksButtonBrushType Image
MTasksButtonImage "$MMImg$regtaskmain.png"
MTasksButtonImageScalingMode Stretch
MTasksButtonFont $MMFont$
MTasksButtonFontSize 8
MTasksButtonFontColor $MMInk$
MTasksButtonTextAlign Left
MTasksButtonTextVerticalAlign Middle
MTasksButtonTextOffsetLeft 24
MTasksButtonTextOffsetRight 4
MTasksButtonIconSize 14
MTasksButtonIconX 5
MTasksButtonIconY 5
MTasksButtonHoverBrushType Image
MTasksButtonHoverImage "$MMImg$seltask.png"
MTasksButtonHoverImageScalingMode Stretch
MTasksButtonActiveBrushType Image
MTasksButtonActiveImage "$MMImg$seltask.png"
MTasksButtonActiveImageScalingMode Stretch
MTasksButtonActiveFontColor $MMInk$
MTasksButtonMinimizedFontColor $MMDim$
MTasksButtonFlashingColor #FFB06A00
MTasksOn MiddleClickUp None !Recycle

; Vista previa de la ventana al pasar por un boton. Animada: crece desde el borde del
; boton hasta su tamano (Animate) y aparece con fundido (ShowAnimation). Colores del tema.
MTasksThumbnailAnimate true
MTasksThumbnailAnimationDuration 180
MTasksThumbnailShowAnimationDuration 150
MTasksThumbnailColor #F034414A
MTasksThumbnailOutlineColor #FF000000
MTasksThumbnailOutlineWidth 1
MTasksThumbnailDistanceFromButton 4

*nTray MTray
MTrayX 100%-204
MTrayY 100%-51
MTrayWidth 204
MTrayHeight 25
MTrayAlwaysOnTop true
MTrayColor $MMBase$
MTrayBrushType Image
; Caja oscura (mismo degradado que el reloj): los iconos de bandeja actuales son blancos.
; El original claro sigue en systray.png.
MTrayImage "$MMImg$systraydark.png"
MTrayImageScalingMode Stretch
MTrayPaddingLeft 50
MTrayPaddingTop 4
MTrayPaddingRight 10
MTrayPaddingBottom 9
MTrayStart TopRight
MTrayPrimaryDirection Horizontal
MTrayColumnSpacing 2
MTrayOverflowAction SizeLeft
MTrayIconSize 12
MTrayOn RightClickUp None !PopupTray

; Tooltip de los iconos de la bandeja: misma fuente de pixel y colores que el tema
; (caja oscura como el reloj, texto blanco, borde negro).
MTrayTooltipFont $MMFont$
MTrayTooltipFontSize 8
MTrayTooltipFontColor $MMInk$
MTrayTooltipTextAntiAliasMode Aliased
MTrayTooltipColor #FF34414A
MTrayTooltipOutlineColor #FF000000
MTrayTooltipOutlineWidth 1
MTrayTooltipTextOffsetLeft 6
MTrayTooltipTextOffsetRight 6
MTrayTooltipTextOffsetTop 4
MTrayTooltipTextOffsetBottom 4
MTrayTooltipTextAlign Center
MTrayTooltipTextVerticalAlign Middle
MTrayTooltipMaxWidth 400

