; Los menus compartidos (config\menus) llevan .icon="$Icon...$"; este tema no usa iconos ahi.
IconExplorer
IconTerminal
IconTaskManager
IconLock
IconLogoff
IconRestart
IconShutdown
*PopupStartMenu "$TxtPrograms$" !PopupPrograms
*PopupStartMenu "$TxtRecent$" !PopupRecentDocuments
*PopupStartMenu "$TxtComputer$" !PopupMyComputer
*PopupStartMenu !Separator
include "$LiteStepDir$config\menus\apps-startmenu.rc"
*PopupStartMenu "$TxtSettings$" !Execute [ms-settings:]
*PopupStartMenu "$TxtRun$" !Run
*PopupStartMenu !Separator
include "$LiteStepDir$config\menus\session-startmenu.rc"

*Popup !New !PopupContext
*Popup !Info "PrototypeX"
*Popup "$TxtPrograms$" !PopupPrograms PXMenuIcons
*Popup "$TxtRecent$" !PopupRecentDocuments PXMenuIcons
*Popup !Separator
include "$LiteStepDir$config\menus\apps.rc"
*Popup "$TxtSettings$" !Execute [ms-settings:]
*Popup !Separator
*Popup "$TxtMultimedia$" Folder
include "$LiteStepDir$config\menus\media.rc"
*Popup ~Folder
*Popup "$TxtShell$" Folder
*Popup "$TxtRecycleLiteStep$" !Recycle
*Popup "$TxtLiteStepFolder$" !Execute [explorer.exe "$LiteStepDir$"]
*Popup "$TxtEditTheme$" !Execute [explorer.exe "$LiteStepDir$themes\$ThemeName$"]
*Popup "$TxtThemes$" !PopupThemes
*Popup ~Folder
*Popup !Separator
*Popup "$TxtLock$" !Execute [rundll32.exe user32.dll,LockWorkStation]
*Popup "$TxtShutDown$" !Execute [shutdown.exe /s /t 0]
*Popup ~New

*Popup !New !PopupTray
*Popup !Info "$TxtTray$"
*Popup "$TxtNetwork$" !Execute [ms-settings:network]
*Popup "$TxtSound$" !Execute [ms-settings:sound]
*Popup "$TxtBluetooth$" !Execute [ms-settings:bluetooth]
*Popup !Separator
*Popup "$TxtTaskManager$" !Execute [taskmgr.exe]
*Popup ~New
